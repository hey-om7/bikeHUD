# Google Maps API key (for geocoding & directions)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/trip-pilot

# JWT secret for auth tokens (use a strong random string in production)
JWT_SECRET=your_jwt_secret_here

# Port (optional, defaults to 3001; Render sets this automatically)
# PORT=3001
